{
  "uuid": "70606b50-137b-45c3-8688-545398dc85a0",
  "id": "search_via_perplexity",
  "iconURL": "https://custom.typingmind.com/assets/models/perplexityai.png",
  "emoji": "🔍",
  "title": "Perplexity Search",
  "userSettings": [
    {
      "name": "apiKey",
      "label": "Perplexity API Key",
      "type": "password",
      "required": true,
      "description": "Get your API Key from Perplexity: https://console.perplexity.ai/"
    },
    {
      "name": "model",
      "label": "Model",
      "description": "Optional, default: \"perplexity/sonar\"",
      "defaultValue": "perplexity/sonar"
    },
    {
      "name": "systemMessage",
      "label": "System Message",
      "description": "Optional, default: \"Be precise and concise\"",
      "defaultValue": "Be precise and concise"
    },
    {
      "name": "maxResults",
      "label": "Max Results",
      "type": "number",
      "description": "Optional, default: 10 (max 50)",
      "defaultValue": 10
    }
  ],
  "openaiSpec": {
    "name": "search_via_perplexity",
    "description": "Search for information from the internet using Perplexity.",
    "parameters": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "The search keyword"
        }
      },
      "required": ["keyword"]
    }
  },
  "httpAction": {
    "id": "b156833f-9599-4155-bba9-e713dd21aa01",
    "method": "POST",
    "name": "",
    "url": "https://api.perplexity.ai/v1/responses",
    "requestBody": "{\"model\": \"{model}\",\"instructions\": \"{systemMessage}\",\"input\": \"{keyword}\",\"tools\": [{\"type\": \"web_search\",\"max_results\": {maxResults}}],\"tool_choice\": {\"type\": \"web_search\"}}",
    "requestHeaders": "{\"accept\": \"application/json\",\"content-type\": \"application/json\",\"authorization\": \"Bearer {apiKey}\"}",
    "resultTransform": {
      "engine": "handlebars",
      "templateString": "{{#each output}}{{#each content}}{{text}}{{/each}}{{/each}}\n\n{{#each output}}{{#if results}}\n Citations:\n{{#each results}}[{{@index}}] {{url}}\n{{/each}}{{/if}}{{/each}}"
    },
    "hasResultTransform": true,
    "hasBody": true,
    "hasHeaders": true
  },
  "implementationType": "javascript",
  "outputType": "respond_to_ai"
}
